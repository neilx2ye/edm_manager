# Migrations (schema owner)
DATABASE_URL=postgresql://edm_migrator:CHANGE_ME@localhost:5432/edm
# Business queries (RLS enforced)
EDM_APP_DATABASE_URL=postgresql://edm_app:CHANGE_ME@localhost:5432/edm
# Background tasks / API-key lookup (BYPASSRLS, server-only)
EDM_SERVICE_DATABASE_URL=postgresql://edm_service:CHANGE_ME@localhost:5432/edm

# Auth.js
AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true

# Local file storage
EDM_STORAGE_DIR=/var/lib/edm/storage

# Server
PORT=3000
WS_PORT=3001
WS_HOST=0.0.0.0

# 前端 WebSocket 地址（仅本地开发需指定独立端口；生产经反向代理走同源 /ws，留空即可）
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
